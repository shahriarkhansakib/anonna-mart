# =============================================================================
# APPLICATION & PORTS
# =============================================================================
NODE_ENV="development"
PORT="5003"
NEXT_PUBLIC_APP_URL="http://localhost:5003"
NEXT_PUBLIC_API_URL="http://localhost:5003"

# =============================================================================
# DATABASE (Neon PostgreSQL / Local Docker)
# =============================================================================
# Local Docker: postgresql://postgres:password@localhost:5434/growmate_db
# Production Neon (Pooled): postgresql://neondb_owner:npg_xxx@ep-xxx-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5434/growmate_db"

# Production Neon Direct / Unpooled (Optional, for running direct migrations):
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:npg_xxx@ep-xxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# =============================================================================
# REDIS (Upstash Redis / Local Docker)
# =============================================================================
# Local Docker Redis:
REDIS_URL="redis://127.0.0.1:6380"

# Production Serverless Upstash Redis (HTTP REST-based):
UPSTASH_URL="https://xxx.upstash.io"
UPSTASH_TOKEN="xxx"
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# =============================================================================
# BETTER-AUTH & GOOGLE OAUTH
# =============================================================================
# Generate a secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="growmate-e2e-secret-key-32-characters-minimum-length"
BETTER_AUTH_URL="http://localhost:5003"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# =============================================================================
# TRANSACTIONAL EMAIL (Resend) & COURIER (Steadfast)
# =============================================================================
RESEND_API_KEY="re_xxxxxxxxxxxx"
STEADFAST_API_KEY="your-steadfast-api-key"
STEADFAST_SECRET_KEY="your-steadfast-secret-key"
