{
  "name": "@growmate/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config=drizzle.config.ts",
    "push": "drizzle-kit push --config=drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "studio": "drizzle-kit studio --config=drizzle.config.ts --port=5559",
    "reset": "tsx src/reset.ts",
    "seed": "tsx src/seeds/index.ts",
    "seed:admin": "tsx src/seeds/admin/seed-admin.ts",
    "seed:catalog": "tsx src/seeds/catalog/seed-catalog.ts",
    "seed:cloudinary": "tsx src/seeds/upload-to-cloudinary.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "better-auth": "^1.7.11",
    "cloudinary": "^2.5.1",
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.4",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
