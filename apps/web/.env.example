# APPLICATION & PORTS
NODE_ENV="development"
PORT="5003"
NEXT_PUBLIC_APP_URL="http://localhost:5003"
NEXT_PUBLIC_API_URL="http://localhost:5003"

# DATABASE (Cloud Neon or Local Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5434/anonna_mart"

# CACHE & SESSIONS (Cloud Upstash or Local Docker Redis)
# Cloud Upstash Redis (HTTP REST Client):
UPSTASH_URL="https://xxx.upstash.io"
UPSTASH_TOKEN="xxx"
# Local Docker Redis (default if UPSTASH_URL is omitted):
REDIS_URL="redis://127.0.0.1:6380"

# BETTER-AUTH & GOOGLE OAUTH
# Generate a secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="anonna-mart-e2e-secret-key-32-characters-minimum-length"
BETTER_AUTH_URL="http://localhost:5003"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# TRANSACTIONAL EMAIL (Resend) & COURIER (Steadfast)
RESEND_API_KEY="re_xxxxxxxxxxxx"
STEADFAST_API_KEY="your-steadfast-api-key"
STEADFAST_SECRET_KEY="your-steadfast-secret-key"

# AI CHATBOT (TOKEN HARBOR GATEWAY)
TOKENHARBOR_API_KEY="your-tokenharbor-api-key"
TOKENHARBOR_BASE_URL="https://tokenharbor.ai/v1"
TOKENHARBOR_MODEL="mimo-v2.6-flash:free"

# CLOUDINARY MEDIA STORAGE
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

