{
  "name": "growmate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "test": "turbo run test",
    "db:push": "pnpm --filter @growmate/db push --force",
    "db:studio": "pnpm --filter @growmate/db studio",
    "db:generate": "pnpm --filter @growmate/db generate",
    "db:reset": "pnpm --filter @growmate/db reset && pnpm db:push && pnpm db:seed",
    "db:seed": "pnpm --filter @growmate/db seed",
    "db:seed:admin": "pnpm --filter @growmate/db seed:admin",
    "db:seed:cloudinary": "pnpm --filter @growmate/db seed:cloudinary",
    "db:docker:reset": "docker compose down -v --remove-orphans && docker compose up -d --wait && pnpm db:push && pnpm db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  }
}
