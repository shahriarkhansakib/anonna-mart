# =============================================================================
# Dependencies
# =============================================================================
node_modules
.pnp
.pnp.js

# =============================================================================
# Production and Local Build Outputs
# =============================================================================
.next/
out/
build/
dist/
.output/
.turbo/
*.tsbuildinfo
next-env.d.ts

# =============================================================================
# Environment Files (Keep .env.example tracked)
# =============================================================================
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
apps/*/.env
apps/*/.env.local
apps/*/.env*.local
packages/*/.env
packages/*/.env.local
packages/*/.env*.local

# Allow example environment files for onboarding
!.env.example
!apps/*/.env.example
!packages/*/.env.example

# =============================================================================
# Seed Scripts & Local Fixtures (100% Git-Ignored)
# =============================================================================
packages/db/src/seed.ts
packages/db/src/seed-permissions.ts
packages/db/src/seeds/
packages/db/seeds/
apps/api/scripts/
**/seed*.ts

# =============================================================================
